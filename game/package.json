{
  "name": "@ubomber/game",
  "private": true,
  "version": "0.1.0",
  "description": "uBomber game: GodotJS project plus the engine-agnostic core simulation",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle:net": "esbuild src/net/bundle-entry.ts --bundle --format=iife --global-name=UBomberNet --platform=browser --outfile=../web/public/game/net-bundle.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
